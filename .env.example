# Configuration environment pour Afriova AI
# Copiez ce fichier vers .env et remplissez les valeurs

# ===== APPLICATION =====
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ===== DATABASE =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afriova

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM PROVIDERS =====
# Obtenez vos clés auprès des fournisseurs respectifs
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# Pour les modèles locaux (llama.cpp, etc.)
LOCAL_LLM_URL=http://localhost:8080  # Exemple pour llama.cpp server

# ===== MOBILE MONEY PROVIDERS =====
# Orange Money
ORANGE_MONEY_API_KEY=your_orange_money_api_key
ORANGE_MONEY_API_SECRET=your_orange_money_api_secret

# MTN Mobile Money
MTN_MOMO_API_KEY=your_mtn_momo_api_key
MTN_MOMO_API_SECRET=your_mtn_momo_api_secret

# Wave
WAVE_API_KEY=your_wave_api_key

# ===== OTHER INTEGRATIONS =====
# Google Workspace
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Microsoft Outlook/Office 365
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# Twilio (pour SMS/WhatsApp alternatif)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid / Email
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=no-reply@afriova.ai

# ===== SECURITY =====
SECRET_KEY=your_super_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== MONITORING =====
SENTRY_DSN=your_sentry_dsn_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=afriova-ai

# ===== FEATURE FLAGS =====
ENABLE_SMS=True
ENABLE_WHATSAPP=True
ENABLE_EMAIL=True
ENABLE_VOICE_CALLS=True
ENABLE_MOBILE_MONEY=True
ENABLE_INVOICING=True
ENABLE_REPORTING=True

# ===== LOCALIZATION =====
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en,ar,sw,wo,yo,ha
DEFAULT_CURRENCY=XOF
SUPPORTED_CURRENCIES=XOF,XAF,NGN,KES,GHS,ZAR,MAD,USD,EUR